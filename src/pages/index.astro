---
import Layout from '../layouts/Layout.astro';

const testFamilies = [
  {
    name: 'Parametric Tests',
    desc: 'T-tests, one-way and factorial ANOVA, repeated measures, ANCOVA, MANOVA, MANCOVA.',
    anchor: '/spss-statistical-tests-explained/#parametric-tests',
  },
  {
    name: 'Correlation & Regression',
    desc: 'Pearson correlation, simple/multiple/hierarchical regression, logistic regression, moderation and mediation.',
    anchor: '/spss-statistical-tests-explained/#regression',
  },
  {
    name: 'Non-Parametric Tests',
    desc: 'Mann-Whitney U, Wilcoxon, Kruskal-Wallis, Friedman, chi-square, Spearman’s rho, McNemar’s test.',
    anchor: '/spss-statistical-tests-explained/#non-parametric-tests',
  },
  {
    name: 'Multivariate & Advanced',
    desc: 'Factor analysis, PCA, reliability analysis, cluster analysis, SEM/Amos, survival analysis, power analysis.',
    anchor: '/spss-statistical-tests-explained/#multivariate',
  },
];

const serviceFormats = [
  { name: 'Homework Help', href: '/spss-homework-help/' },
  { name: 'Coursework Help', href: '/spss-coursework-help/' },
  { name: 'Project / Report Help', href: '/spss-project-report-help/' },
  { name: 'Exam Help', href: '/spss-exam-help/' },
  { name: 'Dissertation & Thesis Chapters', href: '/spss-dissertation-thesis-statistics-help/' },
];

const academicLevels = [
  { name: 'Undergraduate', href: '/undergraduate-spss-assignment-help/' },
  { name: "Master's Thesis", href: '/masters-thesis-spss-help/' },
  { name: 'PhD Dissertation', href: '/phd-dissertation-spss-help/' },
  { name: 'DNP Project', href: '/dnp-project-spss-help/' },
  { name: 'EdD Dissertation', href: '/edd-dissertation-spss-help/' },
];

const subjectDomains = [
  { name: 'Psychology', href: '/spss-for-psychology-research/' },
  { name: 'Nursing & Healthcare', href: '/spss-for-nursing-healthcare-research/' },
  { name: 'Business & Management', href: '/spss-for-business-management-research/' },
  { name: 'Education', href: '/spss-for-education-research/' },
  { name: 'Social Science', href: '/spss-for-social-science-research/' },
  { name: 'Public Health', href: '/spss-for-public-health-epidemiology/' },
];

const faqs = [
  {
    q: 'What does SPSS assignment help include?',
    a: 'We help with every stage of an SPSS task: choosing the correct statistical test, checking its assumptions, running the analysis, interpreting the output, and reporting the results in the format your course or committee expects, typically APA.',
  },
  {
    q: 'Which SPSS tests and analyses do you cover?',
    a: 'We cover parametric tests (t-tests, ANOVA, ANCOVA, MANOVA), correlation and regression (including logistic regression, moderation, and mediation), non-parametric tests (Mann-Whitney U, Wilcoxon, Kruskal-Wallis, Friedman, chi-square), and advanced methods such as factor analysis, PCA, reliability analysis, cluster analysis, SEM in Amos, survival analysis, and power analysis.',
  },
  {
    q: 'Can you help with a dissertation or thesis, not just assignments?',
    a: 'Yes. We support Chapter 3 statistical analysis plans, Chapter 4 results, and Chapter 5 discussion for undergraduate, master’s, PhD, DNP, and EdD projects.',
  },
  {
    q: 'I don’t know which statistical test I need. Can you help?',
    a: 'Yes. Send us your research question and dataset and we will confirm the right test and its assumptions before any analysis starts. You can also use our statistical test guide to narrow it down yourself.',
  },
  {
    q: 'What do I need to send you to get started?',
    a: 'Your assignment instructions, your dataset (SPSS .sav, Excel, or CSV), and your deadline. Send them by WhatsApp or email and we will reply with the tests required, the turnaround time, and a final price.',
  },
  {
    q: 'How much does SPSS help cost?',
    a: 'Starting prices are $45 for homework help, $60 for assignment or coursework help, $75 for a project or report, and $150 per dissertation chapter. Exam help is quoted individually. The final price is confirmed with you before we begin.',
  },
  {
    q: 'Do you help with SPSS exams?',
    a: 'Yes, we offer SPSS exam help for statistics exam preparation and support. Timed practicals and take-home exams are priced by scope and turnaround.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Layout
  title="SPSS Assignment Help — Expert Statistical Analysis for Every Test, Chapter, and Level"
  description="Get expert help selecting, running, interpreting, and reporting SPSS statistical tests — for homework, coursework, projects, exams, and dissertation chapters."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-slate-200 bg-slate-50">
    <!--
      Hero illustration, responsive: the 16:9 desktop version keeps its busy
      two-thirds on the right (object-right), so the gradient only needs to
      cover the empty left third for text legibility. The 1:1 mobile version
      is centered with no built-in clear zone, so it's dropped to low opacity
      (a faint decorative wash) rather than relying on a gradient alone —
      body text wraps full-width on mobile and would cross the busy panels
      otherwise.
    -->
    <picture class="absolute inset-0 opacity-20 md:opacity-100">
      <source media="(max-width: 767px)" srcset="/hero-mobile-1x1.webp" />
      <img
        src="/hero-desktop-16x9.webp"
        alt=""
        class="h-full w-full object-cover object-center md:object-right"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-50 via-slate-50/90 to-slate-50/10 md:via-slate-50/90 md:to-slate-50/10"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="max-w-xl">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          SPSS Assignment Help — Expert Statistical Analysis for Every Test, Chapter, and Level
        </h1>
        <p class="mt-6 text-lg text-slate-600">
          Whether you need one SPSS test run correctly or an entire dissertation
          results chapter written, we help you select the right analysis, check
          its assumptions, interpret the output, and report it the way your
          course or committee expects.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/get-started/"
            class="rounded-md bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700"
          >
            Get SPSS Assignment Help
          </a>
          <a
            href="/spss-statistical-tests-explained/"
            class="rounded-md border border-slate-300 bg-white/80 px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-white"
          >
            Find Your Statistical Test
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What counts as an SPSS assignment -->
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-slate-900">What Counts as an SPSS Assignment?</h2>
    <p class="mt-4 text-slate-600">
      An SPSS assignment is any academic task that requires you to use IBM
      SPSS Statistics to select the correct statistical test, check that
      test's assumptions, run the analysis, interpret the output, and report
      the result in the format your course or committee requires (typically
      APA). That covers a single homework question on a t-test just as much
      as it covers a full dissertation results chapter built from a 40-item
      survey dataset.
    </p>
  </section>

  <!-- Test families -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900">
        SPSS Statistical Tests We Cover
      </h2>
      <p class="mt-2 max-w-2xl text-slate-600">
        Every major test family, with the specific assumptions, SPSS menu
        paths, and effect-size benchmarks that separate a passing answer from
        a guess.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {testFamilies.map((family) => (
          <a
            href={family.anchor}
            class="rounded-lg border border-slate-200 bg-white p-6 transition-shadow hover:shadow-md"
          >
            <h3 class="font-semibold text-slate-900">{family.name}</h3>
            <p class="mt-2 text-sm text-slate-600">{family.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Service formats -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-slate-900">SPSS Help by Service Type</h2>
    <ul class="mt-6 flex flex-wrap gap-3">
      {serviceFormats.map((item) => (
        <li>
          {item.href ? (
            <a
              href={item.href}
              class="block rounded-full border border-slate-300 px-4 py-2 text-sm text-slate-700 hover:border-blue-300 hover:text-blue-600"
            >
              {item.name}
            </a>
          ) : (
            <span class="block rounded-full border border-slate-300 px-4 py-2 text-sm text-slate-700">
              {item.name}
            </span>
          )}
        </li>
      ))}
    </ul>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-blue-100 bg-blue-50 p-6">
        <h3 class="font-semibold text-slate-900">Dissertation and Thesis Statistics</h3>
        <p class="mt-2 text-sm text-slate-600">
          Chapter 3 analysis plans, Chapter 4 results, and Chapter 5 discussion
          — the highest-stakes SPSS work most students face.
        </p>
        <a
          href="/spss-dissertation-thesis-statistics-help/"
          class="mt-4 inline-block text-sm font-semibold text-blue-700 hover:underline"
        >
          See Dissertation &amp; Thesis Help &rarr;
        </a>
      </div>

      <div class="rounded-lg border border-blue-100 bg-blue-50 p-6">
        <h3 class="font-semibold text-slate-900">Full-Dataset Data Analysis</h3>
        <p class="mt-2 text-sm text-slate-600">
          A whole dataset and a set of research questions, not just one test
          — cleaned, analysed, and reported from raw data to final results.
        </p>
        <a
          href="/spss-data-analysis-help/"
          class="mt-4 inline-block text-sm font-semibold text-blue-700 hover:underline"
        >
          See Data Analysis Help &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Academic levels -->
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900">SPSS Help by Academic Level</h2>
      <p class="mt-2 max-w-2xl text-slate-600">
        From an introductory undergraduate problem set to a PhD, DNP, or EdD
        dissertation, the statistical rigor expected of you changes — our
        support scales with it.
      </p>
      <ul class="mt-6 flex flex-wrap gap-3">
        {academicLevels.map((level) => (
          <li>
            <a
              href={level.href}
              class="block rounded-full bg-white px-4 py-2 text-sm text-slate-700 shadow-sm hover:text-blue-600"
            >
              {level.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Subject domains -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-slate-900">SPSS Help by Subject</h2>
    <p class="mt-2 max-w-2xl text-slate-600">
      Psychology, nursing, business, education, social science, and public
      health research each lean on different tests and reporting
      conventions — we work within the ones your field actually uses.
    </p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {subjectDomains.map((domain) => (
        <li>
          {domain.href ? (
            <a
              href={domain.href}
              class="rounded-full border border-slate-300 px-4 py-2 text-sm text-slate-700 hover:border-blue-300 hover:text-blue-600"
            >
              {domain.name}
            </a>
          ) : (
            <span class="block rounded-full border border-slate-300 px-4 py-2 text-sm text-slate-700">
              {domain.name}
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQs -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-slate-900">SPSS Assignment Help FAQs</h2>
    <div class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
      {faqs.map((faq) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900">
            {faq.q}
            <span class="text-blue-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-slate-600">{faq.a}</p>
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </section>

  <!-- Final CTA -->
  <section class="border-t border-slate-200 bg-slate-900">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white">
        Not sure which test you need?
      </h2>
      <p class="mt-3 text-slate-300">
        Start with the statistical test guide, or tell us about your
        assignment and we'll point you to the right help.
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <a
          href="/spss-statistical-tests-explained/"
          class="rounded-md bg-white px-6 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100"
        >
          Find Your Statistical Test
        </a>
        <a
          href="/get-started/"
          class="rounded-md border border-slate-600 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-800"
        >
          Get Started
        </a>
      </div>
    </div>
  </section>
</Layout>
