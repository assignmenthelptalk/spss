---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  pathway?: string;
  headerImage?: string;
}

const { title, description, h1, pathway, headerImage } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    {pathway && (
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-600">
        {pathway}
      </p>
    )}
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      {h1}
    </h1>
    {headerImage && (
      <img
        src={headerImage}
        alt=""
        class="mt-8 h-56 w-full rounded-lg object-cover object-center sm:h-64"
      />
    )}

    <div class="prose prose-slate mt-8 max-w-none prose-h2:text-2xl prose-h2:font-bold prose-h3:text-lg">
      <slot />
    </div>

    <div class="mt-12 rounded-lg border border-blue-100 bg-blue-50 p-6">
      <p class="font-semibold text-slate-900">Need this test run for your assignment?</p>
      <p class="mt-2 text-sm text-slate-600">
        Send us your dataset and research question and we'll take it from
        here — correct test, correct assumptions, correctly reported.
      </p>
      <a
        href="/get-started/"
        class="mt-4 inline-block rounded-md bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700"
      >
        Get SPSS Assignment Help
      </a>
    </div>
  </article>
</Layout>
